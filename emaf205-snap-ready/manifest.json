{
  "manifest_version": 3,
  "name": "EMAF205 SNAP",
  "version": "1.2.0",
  "description": "Capture the visible Chrome tab and copy it directly to the clipboard as PNG.",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Screenshot \u2192 clipboard",
    "default_popup": "capture.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
